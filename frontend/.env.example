# ─────────────────────────────────────────────────────────────
# JobFinder Frontend — Environment Variables
# Copy this file to `.env.local` and fill in your values.
# All NEXT_PUBLIC_ variables are bundled into client-side code.
# ─────────────────────────────────────────────────────────────

# ── Backend API Proxy Base (used in next.config.ts rewrites)
# This MUST be set as a BUILD-TIME env var in Vercel as well.
BACKEND_ORIGIN=http://localhost:8080

# ── Auth
# Proxied via Next.js rewrites → backend
NEXT_PUBLIC_AUTH_API_URL=/api/auth

# ── Jobs
NEXT_PUBLIC_JOBS_API_URL=/api/jobs

# ── User Profile
NEXT_PUBLIC_PROFILE_API_URL=/api/users/profile

# ── Saved Jobs
NEXT_PUBLIC_SAVED_JOBS_API_URL=/api/saved-jobs
NEXT_PUBLIC_SAVED_JOBS_API_TIMEOUT_MS=15000

# ── Email Alerts
NEXT_PUBLIC_ALERTS_API_URL=/api/users/profile/alerts

# ── CV Parser (uses base /api route)
NEXT_PUBLIC_API_URL=/api